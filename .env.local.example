# Projeto Supabase do BFIT (separado do sistema de Gestão de Financiamento)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Secreta: usada só no servidor para o administrador criar usuários. Nunca coloque NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Segredo que a Vercel manda nos envios agendados (vercel.json).
CRON_SECRET=

# Canal dos relatórios em PDF: whatsapp (padrão) ou email (envio antigo por SMTP, para voltar atrás).
NOTIFY_CHANNEL=whatsapp

# ---------------- WhatsApp (todas secretas: nunca use NEXT_PUBLIC_ nelas)
# Provedor: zapi (padrão) ou meta.
WHATSAPP_PROVIDER=zapi

# Z-API (https://z-api.io): ID e token da instância, e o token de segurança da conta (Client-Token).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# WhatsApp Cloud API (Meta), só se WHATSAPP_PROVIDER=meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=relatorio_bfit
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------------- E-mail (SMTP), usado só com NOTIFY_CHANNEL=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
